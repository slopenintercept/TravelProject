# Copy to .env and fill in. Never commit .env.
# Variable names match the Akamai Hack Midwest starter kit, so its .env works here too.
# Every optional block has a local fallback, and /api/health reports which one is in use.

# --- Akamai hosted inference (required for live agents) -----------------------
# OpenAI-compatible chat completions. Paste the team key from the organizers (starts with hk_).
OPENAI_BASE_URL=https://ws.akamai-workshops.com/v1
OPENAI_API_KEY=
CHAT_MODEL=hackathon-chat
# The workshop endpoint allows 60 requests/min per team and 4,096 output tokens.
MODEL_RPM=50
MODEL_MAX_TOKENS=2000

# --- Research search (required for live research) -----------------------------
# Free key from https://app.tavily.com. Without it web_research fails and the
# lodging, transport and attractions agents fall back to saved results.
TAVILY_API_KEY=

# --- Stripe test mode: the Pay together holds on the Finish screen -------------
# A test key (sk_test_ or rk_test_) from https://dashboard.stripe.com/test/apikeys. Empty: the holds
# are kept in the trip and Stripe is never called. Live keys are refused.
STRIPE_SECRET_KEY=

# --- Akamai Object Storage: evidence snapshots --------------------------------
# Leave empty on your own machine: snapshots go to data/evidence on disk. deploy/provision.sh
# writes the hosted values to .env.hosted, and deploy/deploy.sh sends them to the server.
OBJ_ENDPOINT=
OBJ_BUCKET=
OBJ_ACCESS_KEY=
OBJ_SECRET_KEY=
OBJ_KEY_ID=

# --- Akamai Managed PostgreSQL: trip state, profile, cache --------------------
# Leave empty on your own machine: a SQLite file at data/tripwright.db. The hosted value is in .env.hosted.
DATABASE_URL=

# --- Behaviour ------------------------------------------------------------------
# true: tools replay recorded results (backend/tripwright/fixtures) and never browse.
DEMO_MODE=false
# true: live tool results and accepted agent results are also saved as demo fixtures.
RECORD_FIXTURES=false
# Parallel headless Chromium sessions in the worker pool.
BROWSER_WORKERS=4
# Seconds a subagent may run before the orchestrator moves on without it.
AGENT_TIMEOUT_S=240
